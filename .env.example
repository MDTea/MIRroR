# ASU Research Computing, OpenAI-compatible endpoint.
# Put the real key in .env.local (same folder). Restart `npm run dev` after you save it.
ASU_OPENAI_API_KEY=
ASU_OPENAI_BASE_URL=https://openai.rc.asu.edu/v1
ASU_OPENAI_MODEL=llama4-maverick-17b

# Optional. Leave both blank to store showings in data/threads.json on this machine.
# Apply supabase/schema.sql in the Supabase SQL editor, then fill these in.
# Use the service role on the server only. Do not prefix it with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
